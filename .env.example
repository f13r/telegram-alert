# --- Telegram user account (MTProto, READ ONLY) ---
# from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# filled by `npm run login` — run ONCE. As sensitive as your password.
TG_SESSION=

# --- Alert bot (Bot API, write only) ---
BOT_TOKEN=

# --- Subscriptions ---
# share: https://t.me/<yourbot>?start=<JOIN_SECRET>
JOIN_SECRET=

# --- Behaviour ---
DATA_DIR=./data
COOLDOWN_MIN=15
FRESHNESS_MIN=10
SHADOW_RETENTION_DAYS=7
WATCHDOG_QUIET_HOURS=6
WATCHDOG_PARSE_STALE_HOURS=1
SCRAPE_INTERVAL_SEC=20

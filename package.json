{
  "name": "telegram-alert",
  "version": "1.0.0",
  "description": "Town air-threat alerts (Вінниця, Ладижин, Козятин) from Telegram monitoring channels",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "scrapecheck": "tsx scripts/scrapecheck.ts",
    "prestart": "npm run build"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "node-cron": "^4.2.1",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
